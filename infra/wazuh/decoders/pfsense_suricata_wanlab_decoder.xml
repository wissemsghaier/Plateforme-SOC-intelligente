<decoder name="pfsense-suricata-wanlab">
  <prematch type="pcre2">suricata\[\d+\]: </prematch>
</decoder>

<decoder name="pfsense-suricata-wanlab-sid">
  <parent>pfsense-suricata-wanlab</parent>
  <regex type="pcre2">\[1:(\d+):\d+\]</regex>
  <order>suricata_sid</order>
</decoder>

<decoder name="pfsense-suricata-wanlab-ips">
  <parent>pfsense-suricata-wanlab</parent>
  <regex type="pcre2">\{[A-Z]+\}\s+(\d{1,3}(?:\.\d{1,3}){3}):(\d+)\s+->\s+(\d{1,3}(?:\.\d{1,3}){3}):(\d+)</regex>
  <order>srcip,srcport,dstip,dstport</order>
</decoder>