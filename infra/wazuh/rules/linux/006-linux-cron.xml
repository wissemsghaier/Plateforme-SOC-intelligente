<group name="soc_lab_phase4_linux_cron,">

  <rule id="100480" level="5">
    <if_sid>1</if_sid>
    <program_name type="pcre2">^CRON$</program_name>
    <match type="pcre2">\(root\)\s+CMD</match>
    <description>PHASE4: Linux root cron command execution observed</description>
    <group>linux,cron,scheduled_task,</group>
  </rule>

  <rule id="100481" level="9" frequency="15" timeframe="300">
    <if_matched_sid>100480</if_matched_sid>
    <description>PHASE4: Repeated Linux root cron command executions</description>
    <group>linux,cron,scheduled_task,anomaly,</group>
  </rule>

  <rule id="100482" level="7">
    <if_sid>1002</if_sid>
    <program_name>CRON</program_name>
    <match>FAILED</match>
    <description>PHASE4: Linux cron execution failure detected</description>
    <group>linux,cron,execution_failure,</group>
  </rule>

</group>