<group name="soc_lab_phase4_linux_auth,">

  <rule id="100460" level="6">
    <if_sid>5710</if_sid>
    <program_name>sshd</program_name>
    <match>Failed password</match>
    <description>PHASE4: Linux failed SSH authentication observed</description>
    <group>linux,authentication_failed,ssh_failed,</group>
  </rule>

  <rule id="100461" level="13" frequency="8" timeframe="120">
    <if_matched_sid>100460</if_matched_sid>
    <same_srcip />
    <description>PHASE4: Linux SSH brute-force attempt</description>
    <mitre><id>T1110</id></mitre>
    <group>attack,bruteforce,linux,ssh,</group>
  </rule>

  <rule id="100462" level="4">
    <if_sid>5715</if_sid>
    <program_name>sshd</program_name>
    <match>Accepted</match>
    <description>PHASE4: Linux successful SSH login observed</description>
    <group>linux,authentication_success,ssh_login,</group>
  </rule>

  <rule id="100463" level="5">
    <if_sid>5400</if_sid>
    <program_name>sudo</program_name>
    <match>COMMAND=</match>
    <description>PHASE4: Linux sudo command execution observed</description>
    <group>linux,privilege_escalation,sudo_activity,</group>
  </rule>

  <rule id="100464" level="7">
    <if_sid>5500</if_sid>
    <program_name>su</program_name>
    <match>session opened for user root</match>
    <description>PHASE4: Linux su session opened for root account</description>
    <group>linux,privilege_escalation,su_activity,</group>
  </rule>

</group>