<group name="soc_lab_phase4_linux,">

  <!-- Base: un blocage UFW TCP -->
  <rule id="100402" level="6">
    <decoded_as>kernel</decoded_as>
    <match type="pcre2">UFW BLOCK.*PROTO=TCP</match>
    <description>PHASE4: Blocked TCP traffic from any source</description>
    <group>network,firewall,portscan_activity,portscan_probe,linux,</group>
  </rule>

  <!-- Corrélation courte: 3 blocages / 60s -->
  <rule id="100400" level="10" frequency="3" timeframe="60">
    <if_matched_sid>100402</if_matched_sid>
    <same_srcip />
    <description>PHASE4: Possible TCP port scan from the same source</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>attack,port_scan,linux,</group>
  </rule>

  <!-- Corrélation forte: 12 blocages / 120s -->
  <rule id="100401" level="11" frequency="12" timeframe="120">
    <if_matched_sid>100402</if_matched_sid>
    <same_srcip />
    <description>PHASE4: Potential TCP port scan from the same source</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>attack,port_scan,linux,</group>
  </rule>

  <!-- Corrélation par groupe -->
  <rule id="100403" level="11" frequency="5" timeframe="60">
    <if_matched_group>portscan_probe</if_matched_group>
    <same_srcip />
    <description>PHASE4: Potential repeated TCP probes from the same source</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>attack,port_scan,linux,</group>
  </rule>

  <!-- DROP/REJECT TCP dans kernel -->
  <rule id="100404" level="6">
    <decoded_as>kernel</decoded_as>
    <match type="pcre2">(DROP|REJECT).*PROTO=TCP</match>
    <description>PHASE4: TCP traffic dropped or rejected by firewall</description>
    <group>network,firewall,portscan_activity,portscan_probe,linux,</group>
  </rule>

  <!-- SYN probe -->
  <rule id="100407" level="6">
    <decoded_as>kernel</decoded_as>
    <match type="pcre2">UFW BLOCK.*PROTO=TCP.*SYN</match>
    <description>PHASE4: UFW BLOCK TCP SYN probing pattern in kernel syslog</description>
    <group>network,firewall,portscan_activity,portscan_probe,linux,</group>
  </rule>

  <!-- ICMP UFW -->
  <rule id="100405" level="5">
    <decoded_as>kernel</decoded_as>
    <match type="pcre2">UFW.*PROTO=ICMP</match>
    <description>PHASE4: ICMP activity seen in UFW firewall logs</description>
    <group>network,icmp_activity,linux,</group>
  </rule>

  <!-- ICMP flood -->
  <rule id="100410" level="12" frequency="20" timeframe="30">
    <if_matched_sid>100405</if_matched_sid>
    <same_srcip />
    <description>PHASE4: Potential ICMP flood from same source</description>
    <mitre>
      <id>T1498</id>
    </mitre>
    <group>attack,dos,icmp_flood,linux,</group>
  </rule>

</group>