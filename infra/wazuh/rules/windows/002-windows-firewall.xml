<group name="soc_lab_phase4_windows,">

  <!-- Windows Filtering Platform -->
  <rule id="100423" level="5">
    <field name="win.system.eventID">^5152$|^5156$|^5157$</field>
    <description>PHASE4: Windows Filtering Platform event</description>
    <group>network,windows,firewall_activity,</group>
  </rule>

  <!-- Paquet ICMP bloqué par Windows Firewall -->
  <rule id="100425" level="5">
    <field name="win.system.eventID">^5152$</field>
    <field name="win.eventdata.protocol">^1$</field>
    <description>PHASE4: Windows blocked ICMP firewall activity</description>
    <group>network,windows,firewall_activity,icmp_activity,</group>
  </rule>

  <!-- Vingt événements ICMP provenant de la même adresse en 30 secondes -->
  <rule id="100426" level="12" frequency="20" timeframe="30">
    <if_matched_group>icmp_activity</if_matched_group>
    <same_field>win.eventdata.sourceAddress</same_field>
    <description>PHASE4: Potential ICMP flood from same source</description>
    <mitre>
      <id>T1498</id>
    </mitre>
    <group>attack,dos,icmp_flood,windows,</group>
  </rule>

  <!-- Connexion TCP bloquée par Windows Firewall -->
  <rule id="100434" level="6">
    <if_sid>60104</if_sid>
    <field name="win.system.eventID">^5152$|^5157$</field>
    <field name="win.eventdata.protocol">^6$</field>
    <description>PHASE4: Windows blocked TCP connection</description>
    <group>network,windows,firewall_activity,portscan_probe,</group>
  </rule>

  <!-- Trois connexions TCP bloquées provenant de la même adresse -->
  <rule id="100435" level="10" frequency="3" timeframe="60">
    <if_matched_sid>100434</if_matched_sid>
    <same_field>win.eventdata.sourceAddress</same_field>
    <description>PHASE4: Possible Windows TCP port scan</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>attack,windows,port_scan,</group>
  </rule>

  <!-- Échec d'authentification Windows -->
  <rule id="100418" level="6">
    <field name="win.system.eventID">^4625$</field>
    <description>PHASE4: Windows failed logon observed</description>
    <group>windows,authentication_failed,</group>
  </rule>

  <!-- Huit échecs de connexion provenant de la même adresse -->
  <rule id="100421" level="13" frequency="8" timeframe="120">
    <if_matched_sid>100418</if_matched_sid>
    <same_field>win.eventdata.ipAddress</same_field>
    <description>PHASE4: Windows brute-force attempt</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>attack,bruteforce,windows,</group>
  </rule>

</group>