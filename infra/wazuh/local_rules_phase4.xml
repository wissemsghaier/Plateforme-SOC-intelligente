<group name="soc_lab_phase4,">

  <!-- Tout paquet TCP bloque par UFW, depuis n importe quelle IP source -->
  <rule id="100402" level="6">
    <decoded_as>kernel</decoded_as>
    <match>UFW BLOCK</match>
    <protocol>^TCP$</protocol>
    <description>PHASE4: Blocked TCP traffic from any source</description>
    <group>network,firewall,portscan_activity,portscan_probe,</group>
  </rule>

  <!-- Trois paquets TCP bloques venant de la meme IP en 60 secondes -->
  <rule id="100400" level="10" frequency="3" timeframe="60">
    <if_matched_sid>100402</if_matched_sid>
    <same_srcip/>
    <description>PHASE4: Possible TCP port scan from the same source</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>attack,port_scan,</group>
  </rule>

  <!-- Douze paquets TCP bloques venant de la meme IP en 120 secondes -->
  <rule id="100401" level="11" frequency="12" timeframe="120">
    <if_matched_sid>100402</if_matched_sid>
    <same_srcip/>
    <description>PHASE4: Potential TCP port scan from the same source</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>attack,port_scan,</group>
  </rule>

  <!-- Cinq evenements appartenant au groupe portscan_probe en 60 secondes -->
  <rule id="100403" level="11" frequency="5" timeframe="60">
    <if_matched_group>portscan_probe</if_matched_group>
    <same_srcip/>
    <description>PHASE4: Potential repeated TCP probes from the same source</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>attack,port_scan,</group>
  </rule>

  <!-- Paquet TCP SYN bloque ou rejete par un pare-feu -->
  <rule id="100404" level="6">
    <decoded_as>kernel</decoded_as>
    <match>DROP|REJECT</match>
    <protocol>^TCP$</protocol>
    <description>PHASE4: TCP traffic dropped or rejected by firewall</description>
    <group>network,firewall,portscan_activity,portscan_probe,</group>
  </rule>

  <!-- UFW TCP SYN : meme detection, plus descriptive -->
  <rule id="100407" level="6">
    <decoded_as>kernel</decoded_as>
    <match>UFW BLOCK</match>
    <protocol>^TCP$</protocol>
    <description>PHASE4: UFW BLOCK TCP SYN probing pattern in kernel syslog</description>
    <group>network,firewall,portscan_activity,portscan_probe,</group>
  </rule>

  <!-- Paquet ICMP observe par UFW -->
  <rule id="100405" level="5">
    <decoded_as>kernel</decoded_as>
    <match>UFW</match>
    <protocol>^ICMP$</protocol>
    <description>PHASE4: ICMP activity seen in UFW firewall logs</description>
    <group>network,icmp_activity,</group>
  </rule>

  <!-- Flood ICMP : 20 paquets de la meme IP en 30 secondes -->
  <rule id="100410" level="12" frequency="20" timeframe="30">
    <if_matched_group>icmp_activity</if_matched_group>
    <same_srcip/>
    <description>PHASE4: Potential ICMP flood from same source</description>
    <mitre>
      <id>T1498</id>
    </mitre>
    <group>attack,dos,icmp_flood,</group>
  </rule>
  <!-- Événement Windows Filtering Platform -->
  <rule id="100423" level="5">
    <decoded_as>windows_eventchannel</decoded_as>
    <field name="win.system.eventID">^5152$|^5156$|^5157$</field>
    <description>PHASE4: Windows Filtering Platform event</description>
    <group>network,windows,firewall_activity,</group>
  </rule>

  <!-- Paquet ou connexion ICMP Windows -->
  <rule id="100425" level="5">
    <if_sid>60104</if_sid>
    <field name="win.system.eventID">^5152$</field>
    <field name="win.eventdata.protocol">^1$</field>
    <description>PHASE4: Windows blocked ICMP firewall activity</description>
    <group>network,windows,firewall_activity,icmp_activity,</group>
  </rule>
  <rule id="100426" level="12" frequency="20" timeframe="30">
  <if_matched_group>icmp_activity</if_matched_group>
  <same_field>win.eventdata.sourceAddress</same_field>
  <description>PHASE4: Potential ICMP flood from same source</description>
  <mitre>
    <id>T1498</id>
  </mitre>
  <group>attack,dos,icmp_flood,</group>
</rule>

  <!-- Connexion TCP Windows bloquée -->
  <rule id="100434" level="6">
    <decoded_as>windows_eventchannel</decoded_as>
    <field name="win.system.eventID">^5152$|^5157$</field>
    <field name="win.eventdata.Protocol">^6$</field>
    <description>PHASE4: Windows blocked TCP connection</description>
    <group>network,windows,firewall_activity,portscan_probe,</group>
  </rule>

  <!-- Plusieurs événements TCP Windows de la même source -->
  <rule id="100435" level="10" frequency="3" timeframe="60">
    <if_matched_sid>100434</if_matched_sid>
    <same_srcip/>
    <description>PHASE4: Possible Windows TCP port scan</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>attack,windows,port_scan,</group>
  </rule>

  <!-- Échec de connexion Windows -->
  <rule id="100418" level="6">
    <decoded_as>windows_eventchannel</decoded_as>
    <field name="win.system.eventID">^4625$</field>
    <description>PHASE4: Windows failed logon observed</description>
    <group>windows,authentication_failed,</group>
  </rule>

  <!-- Plusieurs échecs de connexion Windows -->
  <rule id="100421" level="13" frequency="8" timeframe="120">
    <if_matched_sid>100418</if_matched_sid>
    <same_srcip/>
    <description>PHASE4: Windows brute-force attempt</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>attack,bruteforce,windows,</group>
  </rule>

</group>